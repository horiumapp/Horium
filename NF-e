<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>DANFE - Documento Auxiliar da Nota Fiscal Eletrônica</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Times New Roman", Arial, sans-serif; background: #e2e8f0; padding: 20px; color: #000; }
    
    /* Container A4 Retrato (210mm de largura) */
    .danfe-page {
      width: 210mm;
      min-height: 297mm;
      background: #fff;
      margin: 0 auto;
      padding: 8mm;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    /* Botão de impressão (some na hora de imprimir) */
    .no-print {
      text-align: center;
      margin-bottom: 15px;
    }
    .btn-print {
      background: #2563eb; color: #fff; border: none; padding: 10px 20px;
      font-family: sans-serif; font-weight: bold; border-radius: 6px; cursor: pointer;
    }

    /* Estrutura de Grades do DANFE */
    .row { display: flex; width: 100%; border-left: 1px solid #000; border-top: 1px solid #000; }
    .row:last-child, .border-bottom { border-bottom: 1px solid #000; }
    .col { border-right: 1px solid #000; padding: 2px 4px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
    
    .lbl { font-size: 6pt; text-transform: uppercase; color: #222; margin-bottom: 2px; line-height: 1; }
    .val { font-size: 8.5pt; font-weight: bold; line-height: 1.1; }
    .val-normal { font-size: 8pt; font-weight: normal; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }

    .section-title {
      font-size: 7pt; font-weight: bold; text-transform: uppercase;
      margin-top: 3mm; margin-bottom: 1mm; letter-spacing: 0.3px;
    }

    .linha-pontilhada {
      border-bottom: 1px dashed #000; margin: 4mm 0;
    }

    /* Simulação de Código de Barras 128C */
    .barcode {
      height: 11mm; width: 100%;
      background: repeating-linear-gradient(90deg, #000 0px, #000 2px, transparent 2px, transparent 4px, #000 4px, #000 5px, transparent 5px, transparent 8px);
      margin: 2px 0;
    }

    /* Tabela de Produtos */
    table.prod-table { width: 100%; border-collapse: collapse; font-size: 7pt; }
    table.prod-table th, table.prod-table td { border: 1px solid #000; padding: 2px 3px; }
    table.prod-table th { font-size: 6pt; background: #f8f8f8; text-transform: uppercase; }

    @media print {
      body { background: #fff; padding: 0; }
      .danfe-page { box-shadow: none; width: 100%; padding: 5mm; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>

  <div class="no-print">
    <button class="btn-print" onclick="window.print()">🖨️ Imprimir DANFE / Salvar em PDF</button>
  </div>

  <div class="danfe-page">
    
    <!-- CANHOTO DESTACÁVEL -->
    <div class="row">
      <div class="col" style="width: 80%;">
        <span class="lbl">RECEBEMOS DE EMPRESA EXEMPLO LTDA OS PRODUTOS E/OU SERVIÇOS CONSTANTES DA NOTA FISCAL ELETRÔNICA INDICADA ABAIXO</span>
        <div style="display: flex; border-top: 1px solid #000; margin-top: 4px; padding-top: 2px;">
          <div style="width: 30%; border-right: 1px solid #000; padding-right: 4px;">
            <span class="lbl">DATA DE RECEBIMENTO</span>
            <div style="height: 14px;"></div>
          </div>
          <div style="width: 70%; padding-left: 4px;">
            <span class="lbl">IDENTIFICAÇÃO E ASSINATURA DO RECEBEDOR</span>
            <div style="height: 14px;"></div>
          </div>
        </div>
      </div>
      <div class="col text-center" style="width: 20%; justify-content: center;">
        <div style="font-size: 10pt; font-weight: bold;">NF-e</div>
        <div class="val">Nº 000.000.001</div>
        <div class="val">SÉRIE 001</div>
      </div>
    </div>
    <div class="border-bottom"></div>

    <div class="linha-pontilhada"></div>

    <!-- CABEÇALHO PRINCIPAL -->
    <div class="row">
      <!-- Dados do Emitente -->
      <div class="col" style="width: 42%; justify-content: center; text-align: center; padding: 6px;">
        <div style="font-size: 11pt; font-weight: bold; margin-bottom: 4px;">EMPRESA EXEMPLO LTDA</div>
        <div class="val-normal">Rua das Flores, 123 - Centro</div>
        <div class="val-normal">São Paulo - SP • CEP: 01001-000</div>
        <div class="val-normal">Fone: (11) 3000-0000</div>
      </div>

      <!-- Bloco Central DANFE -->
      <div class="col text-center" style="width: 16%; justify-content: space-around;">
        <div>
          <div style="font-size: 12pt; font-weight: bold;">DANFE</div>
          <div style="font-size: 6pt;">Documento Auxiliar da Nota Fiscal Eletrônica</div>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-around; font-size: 6.5pt; text-align: left;">
          <div>0 - ENTRADA<br>1 - SAÍDA</div>
          <div style="border: 1px solid #000; padding: 2px 6px; font-weight: bold; font-size: 9pt;">1</div>
        </div>
        <div>
          <div class="val" style="font-size: 8pt;">Nº 000.000.001</div>
          <div class="val" style="font-size: 7.5pt;">SÉRIE 001 • Folha 1/1</div>
        </div>
      </div>

      <!-- Código de Barras e Chave de Acesso -->
      <div class="col" style="width: 42%;">
        <div class="barcode"></div>
        <div style="border-top: 1px solid #000; padding-top: 2px;">
          <span class="lbl">CHAVE DE ACESSO</span>
          <div class="val text-center" style="font-size: 7.8pt; letter-spacing: 0.5px;">
            3526 1012 3456 7800 0199 5500 1000 0000 0110 0000 0010
          </div>
        </div>
        <div style="border-top: 1px solid #000; padding-top: 2px; font-size: 6.5pt; text-align: center;">
          Consulta de autenticidade no portal nacional da NF-e www.nfe.fazenda.gov.br/portal
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col" style="width: 58%;">
        <span class="lbl">NATUREZA DA OPERAÇÃO</span>
        <span class="val">Venda de mercadoria adquirida ou recebida de terceiros</span>
      </div>
      <div class="col" style="width: 42%;">
        <span class="lbl">PROTOCOLO DE AUTORIZAÇÃO DE USO</span>
        <span class="val">135260001234567 - 16/10/2026 13:30:05</span>
      </div>
    </div>

    <div class="row border-bottom">
      <div class="col" style="width: 33%;">
        <span class="lbl">INSCRIÇÃO ESTADUAL</span>
        <span class="val">123.456.789.110</span>
      </div>
      <div class="col" style="width: 33%;">
        <span class="lbl">INSCRIÇÃO ESTADUAL DO SUBST. TRIBUTÁRIO</span>
        <span class="val"></span>
      </div>
      <div class="col" style="width: 34%;">
        <span class="lbl">CNPJ</span>
        <span class="val">12.345.678/0001-99</span>
      </div>
    </div>

    <!-- DESTINATÁRIO / REMETENTE -->
    <div class="section-title">Destinatário / Remetente</div>
    <div class="row">
      <div class="col" style="width: 60%;">
        <span class="lbl">NOME / RAZÃO SOCIAL</span>
        <span class="val">JOÃO DA SILVA (NF-E EMITIDA EM AMBIENTE DE HOMOLOGAÇÃO)</span>
      </div>
      <div class="col" style="width: 25%;">
        <span class="lbl">CNPJ / CPF</span>
        <span class="val">987.654.321-00</span>
      </div>
      <div class="col" style="width: 15%;">
        <span class="lbl">DATA DA EMISSÃO</span>
        <span class="val text-center">16/10/2026</span>
      </div>
    </div>
    <div class="row">
      <div class="col" style="width: 45%;">
        <span class="lbl">ENDEREÇO</span>
        <span class="val">Av. Paulista, 1000</span>
      </div>
      <div class="col" style="width: 25%;">
        <span class="lbl">BAIRRO / DISTRITO</span>
        <span class="val">Bela Vista</span>
      </div>
      <div class="col" style="width: 15%;">
        <span class="lbl">CEP</span>
        <span class="val">01310-100</span>
      </div>
      <div class="col" style="width: 15%;">
        <span class="lbl">DATA DA SAÍDA</span>
        <span class="val text-center">16/10/2026</span>
      </div>
    </div>
    <div class="row border-bottom">
      <div class="col" style="width: 40%;">
        <span class="lbl">MUNICÍPIO</span>
        <span class="val">São Paulo</span>
      </div>
      <div class="col" style="width: 20%;">
        <span class="lbl">FONE / FAX</span>
        <span class="val">(11) 99999-9999</span>
      </div>
      <div class="col" style="width: 5%;">
        <span class="lbl">UF</span>
        <span class="val text-center">SP</span>
      </div>
      <div class="col" style="width: 20%;">
        <span class="lbl">INSCRIÇÃO ESTADUAL</span>
        <span class="val">ISENTO</span>
      </div>
      <div class="col" style="width: 15%;">
        <span class="lbl">HORA DA SAÍDA</span>
        <span class="val text-center">13:30:00</span>
      </div>
    </div>

    <!-- CÁLCULO DO IMPOSTO -->
    <div class="section-title">Cálculo do Imposto</div>
    <div class="row">
      <div class="col" style="width: 20%;"><span class="lbl">BASE DE CÁLC. DO ICMS</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 20%;"><span class="lbl">VALOR DO ICMS</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 20%;"><span class="lbl">BASE CÁLC. ICMS S.T.</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 20%;"><span class="lbl">VALOR DO ICMS SUBST.</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 20%;"><span class="lbl">V. TOTAL DOS PRODUTOS</span><span class="val text-right">250,00</span></div>
    </div>
    <div class="row border-bottom">
      <div class="col" style="width: 16%;"><span class="lbl">VALOR DO FRETE</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 16%;"><span class="lbl">VALOR DO SEGURO</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 16%;"><span class="lbl">DESCONTO</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 16%;"><span class="lbl">OUTRAS DESP.</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 16%;"><span class="lbl">VALOR DO IPI</span><span class="val text-right">0,00</span></div>
      <div class="col" style="width: 20%; background: #f1f5f9;"><span class="lbl">V. TOTAL DA NOTA</span><span class="val text-right">250,00</span></div>
    </div>

    <!-- TRANSPORTADOR -->
    <div class="section-title">Transportador / Volumes Transportados</div>
    <div class="row border-bottom">
      <div class="col" style="width: 45%;"><span class="lbl">NOME / RAZÃO SOCIAL</span><span class="val">O PRÓPRIO</span></div>
      <div class="col" style="width: 25%;"><span class="lbl">FRETE POR CONTA</span><span class="val">9 - Sem Transporte</span></div>
      <div class="col" style="width: 15%;"><span class="lbl">PLACA DO VEÍCULO</span><span class="val"></span></div>
      <div class="col" style="width: 15%;"><span class="lbl">CNPJ / CPF</span><span class="val"></span></div>
    </div>

    <!-- DADOS DOS PRODUTOS / SERVIÇOS -->
    <div class="section-title">Dados dos Produtos / Serviços</div>
    <table class="prod-table">
      <thead>
        <tr>
          <th style="width: 10%;">CÓDIGO</th>
          <th style="width: 36%;">DESCRIÇÃO DO PRODUTO / SERVIÇO</th>
          <th style="width: 9%;">NCM/SH</th>
          <th style="width: 6%;">CSOSN</th>
          <th style="width: 6%;">CFOP</th>
          <th style="width: 5%;">UN</th>
          <th style="width: 7%;">QTD</th>
          <th style="width: 9%;">V. UNIT</th>
          <th style="width: 9%;">V. TOTAL</th>
          <th style="width: 3%;">ICMS</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>SKU-001</td>
          <td>Teclado Mecânico Sem Fio</td>
          <td class="text-center">84716052</td>
          <td class="text-center">0102</td>
          <td class="text-center">5102</td>
          <td class="text-center">UN</td>
          <td class="text-right">1,0000</td>
          <td class="text-right">250,0000</td>
          <td class="text-right">250,00</td>
          <td class="text-right">0,00</td>
        </tr>
        <!-- Espaço restante da folha para manter proporção do DANFE -->
        <tr style="height: 95mm;">
          <td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>
        </tr>
      </tbody>
    </table>

    <!-- DADOS ADICIONAIS -->
    <div class="section-title">Dados Adicionais</div>
    <div class="row border-bottom" style="height: 28mm;">
      <div class="col" style="width: 65%; justify-content: flex-start;">
        <span class="lbl">INFORMAÇÕES COMPLEMENTARES</span>
        <div class="val-normal" style="margin-top: 3px;">
          DOCUMENTO EMITIDO POR ME OU EPP OPTANTE PELO SIMPLES NACIONAL. NÃO GERA DIREITO A CRÉDITO FISCAL DE IPI.<br>
          Trib. aprox. R$ 33,62 Federal e R$ 45,00 Estadual (Fonte: IBPT).
        </div>
      </div>
      <div class="col" style="width: 35%; justify-content: flex-start;">
        <span class="lbl">RESERVADO AO FISCO</span>
      </div>
    </div>

  </div>

</body>
</html>