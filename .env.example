# Supabase Credentials (obtenha no dashboard do seu projeto Supabase: Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Chave PIX para recebimento de licenças (opcional)
VITE_PIX_KEY=sua-chave-pix-aqui@dominio.com

# Só para scripts/backup-database.ps1, na sessão do terminal. Não use prefixo VITE_.
# A porta do Postgres está fechada para a internet: libere o seu IP, rode o dump e feche de novo.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres